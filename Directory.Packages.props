<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- fail restore and build on moderate, high or critical vulnerabilities in any package, including indirect ones -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- low-severity vulnerabilities stay warnings, even in CI where TreatWarningsAsErrors is on -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <!-- pinned exactly: must not be above the Roslyn version in the lowest SDK we support (global.json), or the [Failure] generator won't load -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.12.0]" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Rnd" Version="11.0.0" />
    <!-- latest 1.x release, used only by apps/AppBenchmarkv1 to compare against the local 2.x code -->
    <PackageVersion Include="Wrap" Version="1.4.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
  </ItemGroup>
</Project>