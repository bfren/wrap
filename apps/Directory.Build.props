<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- GitHub Actions sets CI=true, so CI fails on any warning; run dotnet build -warnaserror to match it locally -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <!-- needed for IDE0005 (unnecessary usings) to run on build; apps don't need doc comments -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- a non-exhaustive switch over a union must fail the build, not throw at runtime -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8655</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Wrap"/>
    <Using Include="Wrap.Extensions"/>
    <Using Include="Wrap.Linq"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\All\All.csproj" />
  </ItemGroup>
</Project>
